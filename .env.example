# Copy to .env.local (ignored by git) and fill in. Never commit real values.

# SEC requires automated clients to identify themselves: "<app or company name> <contact email>".
SEC_USER_AGENT="Example Research Project contact@example.com"

# Collectors only. Server-side secret key (sb_secret_...): never use a NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=

# Web app (server-side, read-only). Publishable key (sb_publishable_...), never the secret key.
SUPABASE_PUBLISHABLE_KEY=
