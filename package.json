{
  "name": "stock-positioning-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Research institutional ownership and short-interest trends in U.S.-listed stocks.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:db": "node --test supabase/tests/*.test.mjs",
    "test:collectors": "node --test \"collectors/**/*.test.mts\"",
    "test:web": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.mts\"",
    "collect:13f": "node --env-file-if-exists=.env.local collectors/sec13f/collect.mts",
    "link:cik": "node --env-file-if-exists=.env.local collectors/sec13f/link-cik.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "fast-xml-parser": "5.11.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "typescript": "^6.0.3"
  }
}
